<?xml version="1.0" encoding="utf-8"?>
<!--
  تهيئة خدمة المساعد الصوتي الرسمية (VoiceInteractionService).
  recognitionService إلزامي ليظهر التطبيق في قائمة المساعد الرقمي.
-->
<!--
  ملاحظة: السمة android:supportsContext غير موجودة في إطار أندرويد
  (AAPT يرفضها: attribute not found) — دعم السياق يتحقق فعلياً عبر
  supportsAssist="true" أدناه، لذا اعتمدنا السمات النظامية الصالحة فقط.
-->
<voice-interaction-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="com.example.app.automation.AgentVoiceSessionService"
    android:recognitionService="com.example.app.automation.AgentRecognitionService"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="true" />
